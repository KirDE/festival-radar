#!/usr/bin/env bash
set -euo pipefail

commit="${1:?usage: activate-release COMMIT [due-health|due-ingest-pilot|due-scheduler-health|due-switch-db|due-switch-legacy]}"
deploy_user="festival-radar-deploy"
incoming="/var/lib/festival-radar-deploy/incoming"
installer="/usr/local/libexec/festival-radar/install-release.sh"

[[ "$commit" =~ ^[0-9a-f]{40}$ ]] || { echo "invalid commit" >&2; exit 2; }
[[ "${SUDO_USER:-}" == "$deploy_user" ]] || { echo "unauthorized deploy caller" >&2; exit 3; }
[[ $# == 1 || $# == 2 ]] || { echo "invalid activation arguments" >&2; exit 2; }

# Existing sudoers grant matches commit-prefixed arguments. Validate every token.
exec 9>/run/festival-radar-activation.lock
flock -n 9 || { echo "activation or source operation already running" >&2; exit 5; }
if [[ $# == 2 ]]; then
  if [[ "$2" == due-switch-db || "$2" == due-switch-legacy || "$2" == due-scheduler-health || "$2" == due-legacy-artifact-diagnose || "$2" == due-reset-legacy-failed || "$2" == due-pause-legacy-timer ]]; then
    # The switch retakes the deployment lock and also holds the shared source
    # lock across mode change and timer/service verification. A deployment
    # racing this unlock is rejected by its exact-release SHA check.
    flock -u 9
    case "$2" in
      due-switch-db) exec /usr/local/libexec/festival-radar/db-due-scheduler "$commit" db-due ;;
      due-switch-legacy) exec /usr/local/libexec/festival-radar/db-due-scheduler "$commit" legacy ;;
      due-reset-legacy-failed) exec /usr/local/libexec/festival-radar/db-due-scheduler "$commit" reset-legacy-failed ;;
      due-pause-legacy-timer) exec /usr/local/libexec/festival-radar/db-due-scheduler "$commit" pause-legacy-timer ;;
      due-scheduler-health) exec /usr/local/libexec/festival-radar/db-due-scheduler "$commit" health ;;
      due-legacy-artifact-diagnose) exec /usr/local/libexec/festival-radar/db-due-scheduler "$commit" diagnose-legacy-artifact ;;
    esac
  fi
  if [[ "$2" == due-health || "$2" == due-ingest-pilot ]]; then
    # The existing sudo grant permits only this root-owned entrypoint. Release
    # the deployment lock; the operator wrapper retakes it and checks the SHA.
    flock -u 9
    if [[ "$2" == due-health ]]; then
      exec /usr/local/libexec/festival-radar/start-db-due "$commit" health
    fi
    exec /usr/local/libexec/festival-radar/start-db-due "$commit" ingest-pilot
  fi
  echo "invalid operation" >&2; exit 2
fi

archive="$incoming/$commit.tar.gz"
environment="$incoming/$commit.env"
for file in "$archive" "$environment"; do
  test -f "$file" && test ! -L "$file" || { echo "missing regular deployment input" >&2; exit 4; }
  test "$(stat -c %U "$file")" = "$deploy_user" || { echo "invalid deployment input owner" >&2; exit 4; }
done

exec "$installer" "$archive" "$commit" "$environment"
