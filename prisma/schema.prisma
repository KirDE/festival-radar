generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SyncKind {
  FAVORITES
  COLLECTIONS
  SAVED_FILTERS
  FESTIVAL_PLANS
}

enum NotificationChannel {
  EMAIL
  TELEGRAM
  WEB_PUSH
}

enum NotificationFrequency {
  IMMEDIATE
  DAILY
  WEEKLY
}

enum NotificationEventType {
  ARTIST_ADDED
  ARTIST_CANCELLED
  FESTIVAL_DATE_MOVED
  TICKETS_ON_SALE
  TICKETS_LOW
  TICKETS_SOLD_OUT
  TIMETABLE_PUBLISHED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum IngestionRunStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum IngestionTrigger {
  SCHEDULE
  MANUAL
  API
  TEST
}

enum IngestionAttemptStatus {
  UNCHANGED
  REVIEW
  PUBLISHABLE
  FAILED
}

enum IngestionReviewState {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
  PUBLISHED
}

model User {
  id                        String                     @id @default(cuid())
  email                     String                     @unique
  passwordHash              String
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  sessions                  Session[]
  documents                 SyncDocument[]
  shareLinks                ShareLink[]
  spotify                   SpotifyConnection?
  notificationPreferences   NotificationPreference[]
  notificationSubscriptions NotificationSubscription[]
  notificationDeliveries    NotificationDelivery[]
}

model NotificationPreference {
  id         String                @id @default(cuid())
  userId     String
  festivalId String?
  eventType  NotificationEventType
  channel    NotificationChannel
  frequency  NotificationFrequency @default(IMMEDIATE)
  enabled    Boolean               @default(true)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, festivalId, eventType, channel])
  @@index([festivalId, eventType, enabled])
}

model NotificationSubscription {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel
  endpoint  String
  metadata  Json?
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, endpoint])
  @@index([userId, channel, enabled])
}

model NotificationEvent {
  id         String                 @id @default(cuid())
  dedupeKey  String                 @unique
  festivalId String
  type       NotificationEventType
  title      String
  message    String
  url        String?
  occurredAt DateTime
  payload    Json?
  createdAt  DateTime               @default(now())
  deliveries NotificationDelivery[]

  @@index([festivalId, type, occurredAt])
}

model NotificationDelivery {
  id            String                @id @default(cuid())
  eventId       String
  userId        String
  channel       NotificationChannel
  frequency     NotificationFrequency
  status        NotificationStatus    @default(PENDING)
  attempts      Int                   @default(0)
  nextAttemptAt DateTime?
  sentAt        DateTime?
  lastError     String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  event         NotificationEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId, channel])
  @@index([status, frequency, nextAttemptAt])
  @@index([userId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SyncDocument {
  id        String     @id @default(cuid())
  userId    String
  kind      SyncKind
  payload   Json
  revision  Int        @default(1)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  shareLink ShareLink?

  @@unique([userId, kind])
}

model ShareLink {
  id         String       @id @default(cuid())
  slug       String       @unique
  userId     String
  documentId String       @unique
  expiresAt  DateTime?
  createdAt  DateTime     @default(now())
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   SyncDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SpotifyConnection {
  id                    String    @id @default(cuid())
  userId                String    @unique
  encryptedRefreshToken String
  spotifyUserId         String
  lastSyncedAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IngestionRun {
  id             String               @id @default(cuid())
  schemaVersion  Int
  trigger        IngestionTrigger
  sourceCommit   String
  startedAt      DateTime             @default(now())
  endedAt        DateTime?
  status         IngestionRunStatus   @default(RUNNING)
  totalSources   Int                  @default(0)
  successful     Int                  @default(0)
  unchanged      Int                  @default(0)
  reviewRequired Int                  @default(0)
  publishable    Int                  @default(0)
  failed         Int                  @default(0)
  attempts       IngestionAttempt[]
  candidates     IngestionCandidate[]
  createdAt      DateTime             @default(now())

  @@index([startedAt])
}

model IngestionSourceState {
  festivalSlug        String    @id
  lastSuccessfulCheck DateTime?
  lastAttemptId       String?
  updatedAt           DateTime  @updatedAt
}

model IngestionAttempt {
  id             String                 @id @default(cuid())
  runId          String
  festivalSlug   String
  requestedUrl   String
  finalUrl       String?
  httpStatus     Int?
  durationMs     Int
  retryCount     Int                    @default(0)
  error          String?
  parserVersions Json
  status         IngestionAttemptStatus
  startedAt      DateTime
  endedAt        DateTime
  priorAttemptId String?
  run            IngestionRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  candidate      IngestionCandidate?

  @@unique([runId, festivalSlug])
  @@index([festivalSlug, endedAt])
}

model IngestionCandidate {
  id               String               @id @default(cuid())
  runId            String
  attemptId        String               @unique
  festivalSlug     String
  schemaVersion    Int
  sourceEdition    String?
  sourceYear       Int?
  normalized       Json
  warnings         Json
  publishable      Boolean
  reviewState      IngestionReviewState @default(PENDING)
  reviewActor      String?
  reviewedAt       DateTime?
  publishedAt      DateTime?
  supersedesId     String?
  catalogueVersion String?
  createdAt        DateTime             @default(now())
  run              IngestionRun         @relation(fields: [runId], references: [id], onDelete: Restrict)
  attempt          IngestionAttempt     @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  evidence         IngestionEvidence[]
  diffs            IngestionDiff[]

  @@index([festivalSlug, createdAt])
}

model IngestionEvidence {
  id            String             @id @default(cuid())
  candidateId   String
  field         String
  observedValue Json?
  sourceUrl     String
  excerpt       String?
  contentHash   String
  observedAt    DateTime
  adapter       String
  candidate     IngestionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, field])
}

model IngestionDiff {
  id             String             @id @default(cuid())
  candidateId    String
  field          String
  beforeValue    Json?
  afterValue     Json?
  reviewRequired Boolean
  policyVersion  String
  createdAt      DateTime           @default(now())
  candidate      IngestionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, createdAt])
}
