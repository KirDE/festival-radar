#!/usr/bin/env bash
set -euo pipefail

commit="${1:?usage: activate-release COMMIT [source-preview|source-apply|source-verify|source-diagnose]}"
deploy_user="festival-radar-deploy"
incoming="/var/lib/festival-radar-deploy/incoming"
installer="/usr/local/libexec/festival-radar/install-release.sh"

[[ "$commit" =~ ^[0-9a-f]{40}$ ]] || { echo "invalid commit" >&2; exit 2; }
[[ "${SUDO_USER:-}" == "$deploy_user" ]] || { echo "unauthorized deploy caller" >&2; exit 3; }
[[ $# -ge 1 && $# -le 2 ]] || { echo "invalid activation arguments" >&2; exit 2; }

# Existing sudoers grant matches commit-prefixed arguments. Validate every token.
exec 9>/run/festival-radar-activation.lock
flock -n 9 || { echo "activation or source operation already running" >&2; exit 5; }
if [[ $# == 2 ]]; then
  case "$2" in
    source-preview|source-apply|source-verify|source-diagnose) mode="${2#source-}" ;;
    *) echo "invalid source operation" >&2; exit 2 ;;
  esac
  root=/opt/festival-radar
  release="$root/releases/$commit"
  [[ "$(readlink -f "$root/current" 2>/dev/null || true)" == "$release" ]] || { echo "deployed commit mismatch" >&2; exit 4; }
  [[ -f "$release/DEPLOYED_COMMIT" && "$(cat "$release/DEPLOYED_COMMIT")" == "$commit" ]] || { echo "release marker mismatch" >&2; exit 4; }
  [[ -f "$release/scripts/deploy/run-source-backfill.ts" ]] || { echo "source operation not packaged" >&2; exit 4; }
  [[ -f /etc/systemd/system/festival-radar-source-backfill@.service ]] || { echo "source unit not installed" >&2; exit 4; }
  if [[ "$mode" == diagnose ]]; then
    # Inspect only the preview unit, never invoke it or access its environment.
    # The three exact-field selectors followed by -u expose which journald
    # metadata is actually present. Each is a bounded sample, not a full count.
    unit=festival-radar-source-backfill@preview.service
    [[ -x "$release/.runtime/node" ]] || { echo "source diagnostic runtime unavailable" >&2; exit 6; }
    for selector in exact stdout unit unit-expanded; do
      case "$selector" in
        exact) fields=("_SYSTEMD_UNIT=$unit" _TRANSPORT=stdout _COMM=node) ;;
        stdout) fields=("_SYSTEMD_UNIT=$unit" _TRANSPORT=stdout) ;;
        unit) fields=("_SYSTEMD_UNIT=$unit") ;;
        unit-expanded) fields=(-u "$unit") ;;
      esac
      # Neither journalctl stderr nor any journal content can reach the caller.
      # The parser emits only fixed labels and numeric counts for allowlisted
      # transport/comm classes, including unexpected and absent values.
      if ! summary="$(journalctl -q --no-pager -o json --output-fields=_TRANSPORT,_COMM --since '-2 hours' -n 200 "${fields[@]}" 2>/dev/null | "$release/.runtime/node" -e '
        let input = "", count = 0;
        const transports = { stdout: 0, journal: 0, syslog: 0, other: 0, missing: 0 };
        const comms = { node: 0, systemd: 0, other: 0, missing: 0 };
        process.stdin.setEncoding("utf8");
        process.stdin.on("data", chunk => { input += chunk; if (input.length > 4000000) process.exit(1); });
        process.stdin.on("end", () => {
          try {
            for (const line of input.split("\n")) {
              if (!line) continue;
              const record = JSON.parse(line);
              count++;
              const transport = typeof record._TRANSPORT === "string" ? record._TRANSPORT : "missing";
              const comm = typeof record._COMM === "string" ? record._COMM : "missing";
              transports[Object.hasOwn(transports, transport) ? transport : "other"]++;
              comms[Object.hasOwn(comms, comm) ? comm : "other"]++;
            }
            console.log("sample=" + count + " transport_stdout=" + transports.stdout + " transport_journal=" + transports.journal + " transport_syslog=" + transports.syslog + " transport_other=" + transports.other + " transport_missing=" + transports.missing + " comm_node=" + comms.node + " comm_systemd=" + comms.systemd + " comm_other=" + comms.other + " comm_missing=" + comms.missing);
          } catch { process.exitCode = 1; }
        });
      ' 2>/dev/null)"; then
        echo "source diagnostic journal unavailable" >&2
        exit 6
      fi
      printf 'SOURCE_DIAG %s %s\n' "$selector" "$summary"
    done
    exit 0
  fi
  unit="festival-radar-source-backfill@$mode.service"
  # A oneshot unit may not retain an InvocationID after start. Share a fresh
  # nonce with PID 1 using a root-owned file, never on a command line.
  nonce_dir=/run/festival-radar-source-backfill
  if [[ ! -e "$nonce_dir" && ! -L "$nonce_dir" ]]; then
    mkdir -m 0700 -- "$nonce_dir" || { echo "source environment directory unavailable" >&2; exit 6; }
  fi
  [[ -d "$nonce_dir" && ! -L "$nonce_dir" && "$(stat -c %u:%a -- "$nonce_dir")" == 0:700 ]] || { echo "source environment directory unsafe" >&2; exit 6; }
  nonce="$(od -An -N32 -tx1 /dev/urandom | tr -d '[:space:]')" || { echo "source nonce unavailable" >&2; exit 6; }
  [[ "$nonce" =~ ^[0-9a-f]{64}$ ]] || { echo "source nonce invalid" >&2; exit 6; }
  env_file="$nonce_dir/$mode.env"
  temp_file="$(mktemp "$nonce_dir/.$mode.XXXXXXXX")" || { echo "source environment unavailable" >&2; exit 6; }
  trap 'rm -f -- "$temp_file" "$env_file"' EXIT
  printf 'SOURCE_BACKFILL_NONCE=%s\n' "$nonce" > "$temp_file"
  [[ "$(stat -c %u:%a -- "$temp_file")" == 0:600 ]] || { echo "source environment unsafe" >&2; exit 6; }
  mv -fT -- "$temp_file" "$env_file"
  # Second-resolution timestamps include the entire second before the start.
  started_at="@$(date +%s)"
  # systemctl may relay unit errors containing protected configuration.
  result=0
  if ! systemctl start "$unit" >/dev/null 2>&1; then
    echo "source operation systemctl start failed" >&2
    result=6
  fi
  # Bounded fresh journal read; same-second stale records have other nonces.
  # Never relay arbitrary logs, only the complete fixed-shape runner audit.
  audit_pattern='^SOURCE_BACKFILL_AUDIT \{"operation":"festival-source-backfill","mode":"'"$mode"'","nonce":"'"$nonce"'","status":"(ok|review-required|migration-missing|guard-or-data-error|disconnect-error)"(,"counts":\{"insert":[0-9]+,"fill":[0-9]+,"preserve":[0-9]+\})?,"drift":[0-9]+\}$'
  for attempt in {1..10}; do
    if entries="$(journalctl --no-pager -o cat --since="$started_at" -n 200 _SYSTEMD_UNIT="$unit" _TRANSPORT=stdout _COMM=node 2>/dev/null)"; then
      if [[ -z "$entries" ]]; then
        journal_state="empty"
      else
        audit=""
        while IFS= read -r line; do
          if [[ "$line" =~ $audit_pattern ]]; then audit="$line"; fi
        done <<< "$entries"
        if [[ -n "$audit" ]]; then
          # Only after matching the whole original record, remove its exact
          # nonce field before forwarding the audit to SSH/Actions stdout.
          audit_prefix='SOURCE_BACKFILL_AUDIT {"operation":"festival-source-backfill","mode":"'"$mode"'","nonce":"'"$nonce"'",'
          printf '%s\n' 'SOURCE_BACKFILL_AUDIT {"operation":"festival-source-backfill","mode":"'"$mode"'",'"${audit#"$audit_prefix"}"
          if [[ "$audit" == *'"status":"ok"'* && "$result" == 0 ]]; then exit 0; fi
          exit 6
        fi
        journal_state="no marker"
      fi
    else
      journal_state="unreadable"
    fi
    if (( attempt < 10 )); then sleep 1; fi
  done
  echo "source operation journal $journal_state" >&2
  exit 6
fi

archive="$incoming/$commit.tar.gz"
environment="$incoming/$commit.env"
for file in "$archive" "$environment"; do
  test -f "$file" && test ! -L "$file" || { echo "missing regular deployment input" >&2; exit 4; }
  test "$(stat -c %U "$file")" = "$deploy_user" || { echo "invalid deployment input owner" >&2; exit 4; }
done

exec "$installer" "$archive" "$commit" "$environment"
