    "@types/react-dom": "^19.0.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "next": "^16.3.3",
    "prisma": "^6.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "zod": "^4.1.12"
  },
  "devDependencies": { "tsx": "^4.20.5" }
