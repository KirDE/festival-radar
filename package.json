{
  "name": "festival-playlists",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prisma:generate": "prisma generate",
    "postinstall": "npm run prisma:generate",
    "pretypecheck": "npm run prisma:generate",
    "build": "next build",
    "prebuild": "npm run prisma:generate",
    "typecheck": "tsc --noEmit",
    "fetch:logos": "node scripts/fetch-festival-logos.mjs",
    "check:sources": "node scripts/check-festival-sources.mjs",
    "ingest": "node scripts/ingest-festivals.mjs",
    "timetables:import": "node scripts/import-timetable.mjs",
    "enrich:artists": "node scripts/enrich-artists.mjs",
    "resolve:artists": "node scripts/resolve-artist-identities.mjs",
    "test:data": "node --import tsx --test $(find tests -maxdepth 1 -name '*.test.mjs' ! -name '*.e2e.test.mjs' -print) && node --experimental-strip-types --test tests/selection-playlist.test.ts && node --import tsx --test tests/domain-boundary.test.ts tests/source-configuration.test.ts tests/playlist-queue.test.ts",
    "test:routes": "node scripts/test-locale-routes.mjs",
    "test:ingestion-db": "node --test tests/ingestion-repository.e2e.test.mjs",
    "notifications:drain-db-due": "node scripts/drain-ingestion-notifications.mjs --db-due",
    "test:playlist-queue": "node --import tsx --test tests/playlist-queue.e2e.test.ts",
    "test:logo-assets": "node --import tsx --test tests/logo-assets.e2e.test.ts",
    "test:logo-serving": "node --import tsx --test tests/logo-serving.test.ts tests/festival-logo.test.ts",
    "test:logo-serving-db": "node --import tsx --test tests/logo-serving.e2e.test.ts",
    "logos:dry-run": "tsx scripts/import-reviewed-logos.ts --dry-run",
    "logos:verify": "tsx scripts/import-reviewed-logos.ts --verify",
    "logos:apply": "tsx scripts/import-reviewed-logos.ts --apply",
    "test:logo-import": "node --import tsx --test tests/logo-import.test.ts tests/logo-import.e2e.test.ts && node --import tsx --test tests/logo-production-apply.e2e.test.ts",
    "test:due-worker": "node --import tsx --test --test-concurrency=1 tests/ingestion-due-worker.e2e.test.mjs tests/db-due-health.e2e.test.mjs",
    "catalog:backfill": "tsx scripts/backfill-catalog.ts",
    "catalog:verify": "tsx scripts/backfill-catalog.ts --verify-only",
    "sources:preview": "tsx scripts/backfill-sources.ts --preview",
    "sources:backfill": "tsx scripts/backfill-sources.ts --apply",
    "sources:verify": "tsx scripts/backfill-sources.ts --verify-only",
    "test:sources": "node --import tsx --test tests/source-configuration.test.ts tests/source-backfill.e2e.test.ts && node --experimental-strip-types --test tests/source-backfill-operation.e2e.test.ts",
    "test:catalog-db": "node --import tsx --test tests/catalog-backfill.e2e.test.ts && node --import tsx --test tests/catalog-repository.e2e.test.ts && node --import tsx --test tests/catalog-publication.e2e.test.ts && node --import tsx --test tests/source-backfill.e2e.test.ts && node --experimental-strip-types --test tests/source-backfill-operation.e2e.test.ts && node --import tsx --test tests/ingestion-lease.e2e.test.ts",
    "test:integration": "node --test --test-concurrency=1 tests/integration/account-routes.test.mjs tests/integration/notification-routes.test.mjs tests/integration/admin-workflows.test.mjs",
    "test:notifications:e2e": "node tests/notification-e2e.mjs",
    "test:admin:integration": "node --test --test-concurrency=1 tests/integration/admin-workflows.test.mjs",
    "test:admin:e2e": "playwright test",
    "analytics:prune": "node scripts/prune-analytics.mjs",
    "playlists:status": "node scripts/build-playlist-status.mjs",
    "playlists:catalog": "node scripts/export-playlist-catalog.mjs",
    "playlists:youtube": "python3 scripts/refresh-youtube-music-playlists.py",
    "test": "python3 -m unittest discover -s tests",
    "test:admin-auth": "node --import tsx --test tests/admin-auth.test.ts",
    "admin:assign-role": "node scripts/assign-admin-role.mjs",
    "test:final-cutover": "node --import tsx --test tests/final-cutover-release.test.mjs tests/playlist-cutover.test.ts tests/logo-serving.test.ts tests/festival-logo.test.ts && python3 -m unittest discover -s tests -p test_playlist_plan.py",
    "test:final-cutover-db": "node --import tsx --test tests/final-cutover.e2e.test.ts",
    "catalog:audit-final": "tsx scripts/audit-final-cutover.ts",
    "playlists:worker": "tsx scripts/playlist-worker.ts",
    "pretest:final-cutover-db": "node scripts/prepare-cutover-test-db.mjs",
    "operational:import": "tsx scripts/import-operational-state.ts",
    "playlists:cutover": "tsx scripts/playlist-cutover.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "next": "^16.3.3",
    "prisma": "^6.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.4",
    "typescript": "^5.7.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "tsx": "^4.20.5"
  }
}
