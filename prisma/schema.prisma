generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SyncKind {
  FAVORITES
  COLLECTIONS
  SAVED_FILTERS
  FESTIVAL_PLANS
}

enum NotificationChannel {
  EMAIL
  TELEGRAM
  WEB_PUSH
}

enum NotificationFrequency {
  IMMEDIATE
  DAILY
  WEEKLY
}

enum NotificationEventType {
  ARTIST_ADDED
  ARTIST_CANCELLED
  FESTIVAL_DATE_MOVED
  TICKETS_ON_SALE
  TICKETS_LOW
  TICKETS_SOLD_OUT
  TIMETABLE_PUBLISHED
}

enum NotificationStatus {
  PENDING
  CLAIMED
  SENT
  FAILED
  SKIPPED
}

enum AdminResourceKind {
  FESTIVAL
  ARTIST
  LINK
  ASSET
  PLAYLIST
}

enum AdminDraftStatus {
  DRAFT
  QUEUED
  APPLIED
  REJECTED
  CONFLICT
}

enum AdminChangeStatus {
  PENDING
  APPROVED
  REJECTED
  CONFLICT
}

enum AdminRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum IngestionRunStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum IngestionTrigger {
  SCHEDULE
  MANUAL
  API
  TEST
}

enum IngestionAttemptStatus {
  UNCHANGED
  REVIEW
  PUBLISHABLE
  FAILED
}

enum IngestionReviewState {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
  PUBLISHED
}

enum UserRole {
  USER
  EDITOR
  ADMIN
}

model User {
  id                        String                     @id @default(cuid())
  email                     String                     @unique
  passwordHash              String
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  role                      UserRole                   @default(USER)
  sessions                  Session[]
  documents                 SyncDocument[]
  shareLinks                ShareLink[]
  spotify                   SpotifyConnection?
  notificationPreferences   NotificationPreference[]
  notificationSubscriptions NotificationSubscription[]
  notificationDeliveries    NotificationDelivery[]
  adminDrafts               AdminDraft[]
  adminDecisions            AdminChange[]              @relation("AdminChangeDecisionActor")
  adminRuns                 AdminParserRun[]           @relation("AdminRunActor")
  adminAuditEntries         AdminAuditEntry[]
}

model AdminDraft {
  id            String            @id @default(cuid())
  resourceKind  AdminResourceKind
  resourceKey   String
  baseRevision  Int
  revision      Int               @default(1)
  status        AdminDraftStatus  @default(DRAFT)
  values        Json
  validation    Json?
  createdById   String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  createdBy     User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  queuedChanges AdminChange[]

  @@unique([resourceKind, resourceKey, revision])
  @@index([resourceKind, resourceKey, status])
  @@index([createdById, updatedAt])
}

model AdminResourceState {
  resourceKind AdminResourceKind
  resourceKey  String
  revision     Int               @default(0)
  values       Json
  updatedAt    DateTime          @updatedAt

  @@id([resourceKind, resourceKey])
}

model AdminChange {
  id             String            @id @default(cuid())
  resourceKind   AdminResourceKind
  resourceKey    String
  field          String
  baseRevision   Int
  beforeValue    Json
  afterValue     Json
  sourceEvidence Json
  confidence     Int?
  status         AdminChangeStatus @default(PENDING)
  draftId        String?
  parserRunId    String?
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  draft          AdminDraft?       @relation(fields: [draftId], references: [id], onDelete: SetNull)
  parserRun      AdminParserRun?   @relation(fields: [parserRunId], references: [id], onDelete: SetNull)
  decidedBy      User?             @relation("AdminChangeDecisionActor", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([resourceKind, resourceKey, status])
  @@index([parserRunId])
}

model AdminParserRun {
  id            String         @id @default(cuid())
  festivalSlug  String
  sourceId      String
  adapter       String
  status        AdminRunStatus @default(RUNNING)
  requestedById String?
  startedAt     DateTime       @default(now())
  finishedAt    DateTime?
  durationMs    Int?
  extracted     Int            @default(0)
  message       String?
  log           Json
  requestedBy   User?          @relation("AdminRunActor", fields: [requestedById], references: [id], onDelete: Restrict)
  changes       AdminChange[]

  @@index([festivalSlug, startedAt])
  @@index([status, startedAt])
}

model AdminAuditEntry {
  id           String             @id @default(cuid())
  actorId      String?
  actorLabel   String
  action       String
  resourceKind AdminResourceKind?
  resourceKey  String?
  beforeValue  Json?
  afterValue   Json?
  evidence     Json?
  metadata     Json?
  target       String?
  detail       Json?
  createdAt    DateTime           @default(now())
  actor        User?              @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([resourceKind, resourceKey, createdAt])
  @@index([actorId, createdAt])
}

model NotificationPreference {
  id         String                @id @default(cuid())
  userId     String
  festivalId String?
  eventType  NotificationEventType
  channel    NotificationChannel
  frequency  NotificationFrequency @default(IMMEDIATE)
  enabled    Boolean               @default(true)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, festivalId, eventType, channel])
  @@index([festivalId, eventType, enabled])
}

model NotificationSubscription {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel
  endpoint  String
  metadata  Json?
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, endpoint])
  @@index([userId, channel, enabled])
}

model NotificationEvent {
  id         String                 @id @default(cuid())
  dedupeKey  String                 @unique
  festivalId String
  type       NotificationEventType
  title      String
  message    String
  url        String?
  occurredAt DateTime
  payload    Json?
  createdAt  DateTime               @default(now())
  deliveries NotificationDelivery[]

  @@index([festivalId, type, occurredAt])
}

model NotificationDelivery {
  id            String                @id @default(cuid())
  eventId       String
  userId        String
  channel       NotificationChannel
  frequency     NotificationFrequency
  status        NotificationStatus    @default(PENDING)
  attempts      Int                   @default(0)
  nextAttemptAt DateTime?
  claimedAt     DateTime?
  claimToken    String?
  sentAt        DateTime?
  lastError     String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  event         NotificationEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId, channel])
  @@index([status, frequency, nextAttemptAt])
  @@index([claimToken])
  @@index([userId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SyncDocument {
  id        String     @id @default(cuid())
  userId    String
  kind      SyncKind
  payload   Json
  revision  Int        @default(1)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  shareLink ShareLink?

  @@unique([userId, kind])
}

model ShareLink {
  id         String       @id @default(cuid())
  slug       String       @unique
  userId     String
  documentId String       @unique
  expiresAt  DateTime?
  createdAt  DateTime     @default(now())
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   SyncDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SpotifyConnection {
  id                    String    @id @default(cuid())
  userId                String    @unique
  encryptedRefreshToken String
  spotifyUserId         String
  lastSyncedAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IngestionRun {
  id             String               @id @default(cuid())
  schemaVersion  Int
  trigger        IngestionTrigger
  sourceCommit   String
  startedAt      DateTime             @default(now())
  endedAt        DateTime?
  status         IngestionRunStatus   @default(RUNNING)
  totalSources   Int                  @default(0)
  successful     Int                  @default(0)
  unchanged      Int                  @default(0)
  reviewRequired Int                  @default(0)
  publishable    Int                  @default(0)
  failed         Int                  @default(0)
  attempts       IngestionAttempt[]
  candidates     IngestionCandidate[]
  createdAt      DateTime             @default(now())

  @@index([startedAt])
}

model IngestionSourceState {
  festivalSlug        String    @id
  lastSuccessfulCheck DateTime?
  lastAttemptId       String?
  updatedAt           DateTime  @updatedAt
}

model IngestionAttempt {
  id             String                 @id @default(cuid())
  runId          String
  festivalSlug   String
  requestedUrl   String
  finalUrl       String?
  httpStatus     Int?
  durationMs     Int
  retryCount     Int                    @default(0)
  error          String?
  parserVersions Json
  status         IngestionAttemptStatus
  startedAt      DateTime
  endedAt        DateTime
  priorAttemptId String?
  priorAttempt   IngestionAttempt?      @relation("AttemptRetry", fields: [priorAttemptId], references: [id], onDelete: SetNull)
  retries        IngestionAttempt[]     @relation("AttemptRetry")
  run            IngestionRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  candidate      IngestionCandidate?

  @@index([runId, festivalSlug])
  @@index([festivalSlug, endedAt])
}

model IngestionCandidate {
  id               String               @id @default(cuid())
  runId            String
  attemptId        String               @unique
  festivalSlug     String
  schemaVersion    Int
  sourceEdition    String?
  sourceYear       Int?
  normalized       Json
  warnings         Json
  publishable      Boolean
  reviewState      IngestionReviewState @default(PENDING)
  reviewActor      String?
  reviewedAt       DateTime?
  publishedAt      DateTime?
  supersedesId     String?
  supersedes       IngestionCandidate?  @relation("CandidateVersion", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy     IngestionCandidate[] @relation("CandidateVersion")
  catalogueVersion String?
  createdAt        DateTime             @default(now())
  run              IngestionRun         @relation(fields: [runId], references: [id], onDelete: Restrict)
  attempt          IngestionAttempt     @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  evidence         IngestionEvidence[]
  diffs            IngestionDiff[]

  @@index([festivalSlug, createdAt])
}

model IngestionEvidence {
  id            String             @id @default(cuid())
  candidateId   String
  field         String
  observedValue Json?
  sourceUrl     String
  excerpt       String?
  contentHash   String
  observedAt    DateTime
  adapter       String
  candidate     IngestionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, field])
}

model IngestionDiff {
  id             String             @id @default(cuid())
  candidateId    String
  field          String
  beforeValue    Json?
  afterValue     Json?
  reviewRequired Boolean
  policyVersion  String
  createdAt      DateTime           @default(now())
  candidate      IngestionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, createdAt])
}
